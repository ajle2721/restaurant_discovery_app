      },
      "publishTime": "2025-07-07T07:28:30.536050436Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25sWFNXVXRiRWRUTjNsWVIydGZYelZOTXpCNGNrRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25sWFNXVXRiRWRUTjNsWVIydGZYelZOTXpCNGNrRRAB!2m1!1s0x3442ae566ccc1753:0x51aa1d6cf6a004b"
