      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25JeVVEbFRNbUpEV2pORGIzUlRjMXB5ZVZock5XYxAB!2m1!1s0x3442aebc7203c179:0x8dff2cd3920f3897"
