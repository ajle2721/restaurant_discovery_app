      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tsVVlUZ3hMWHAzVHpOM1ZXdG1SRGMyYVdOWGFVRRAB!2m1!1s0x3442a9005abde0ef:0x1e83ad64a2f1c58"
