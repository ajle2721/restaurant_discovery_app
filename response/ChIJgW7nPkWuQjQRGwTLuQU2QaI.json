      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xkcVJuRjVkbEphWlROblFqWjJaWHB3YjBkcGFtYxAB!2m1!1s0x3442ae453ee76e81:0xa2413605b9cb041b"
