      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25FMVZ6SlRTR0Z2WlVGMGRsWnRZVFpwYTNSZlRYYxAB!2m1!1s0x3442a99b235e2637:0xec677ad31f5c339a"
