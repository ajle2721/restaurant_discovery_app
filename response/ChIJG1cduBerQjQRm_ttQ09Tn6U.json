      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s1ZmN6TkhOVUpEWkVOS2RtbHBjMVZxZEhKYVNrRRAB!2m1!1s0x3442ab17b81d571b:0xa59f534f436dfb9b"
