      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5WFQyaDBWMGRqVWxJMU1XSkdVbGhVY1dGR2RGRRAB!2m1!1s0x3442ab64b936c329:0x6a6c6c8d77fc897e"
