      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2w5a1kzZGtOVEZrUmtKc1UyczBVRXRFU1ZvMU9YYxAB!2m1!1s0x3442af9104e183cd:0xbd5f0f32578ed0ba"
