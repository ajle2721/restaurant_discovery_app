      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21ZNWRIRmlRVGRzU21ndE5rbGxTME5CZERsM1RVRRAB!2m1!1s0x3442ab364035f98d:0x156dbcacd1cf3a73"
