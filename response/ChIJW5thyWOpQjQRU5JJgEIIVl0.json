      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xvM1V6TmZjbWczT0dOdVVVNVlZbEpvWDJGMk1tYxAB!2m1!1s0x3442a963c9619b5b:0x5d56084280499253"
