      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xodFVHaFRlbEY1V0RCV1NXWXhja1kyYkcxaVNXYxAB!2m1!1s0x3442aea534d41467:0xd86edd2387f956b2"
