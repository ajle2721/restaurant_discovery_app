      "publishTime": "2026-02-04T14:50:25.728137999Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21oYVRsRk1iVk0xTFVwUVZEVndaa1oyTmxOZlkxRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21oYVRsRk1iVk0xTFVwUVZEVndaa1oyTmxOZlkxRRAB!2m1!1s0x3442abe8a74cde99:0xbdc14c9875d8e0b2"
