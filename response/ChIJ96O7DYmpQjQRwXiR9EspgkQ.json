      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25ORVowcE1aMWxoU3psZlJIWlBiM1ZIYUVaamJVRRAB!2m1!1s0x3442a9890dbba3f7:0x4482294bf49178c1"
