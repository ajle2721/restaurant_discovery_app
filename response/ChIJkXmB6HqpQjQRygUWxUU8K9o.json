      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pJdGJWRnlRVkF0VFd0MFEwaDVSRE5CUWpkc1pIYxAB!2m1!1s0x3442a97ae8817991:0xda2b3c45c51605ca"
