      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25SbFNFbGFURkpxTTB4WlJGSkhSMjkyUVVOamVGRRAB!2m1!1s0x345d530d5b085217:0xf9799aef2bc258c"
