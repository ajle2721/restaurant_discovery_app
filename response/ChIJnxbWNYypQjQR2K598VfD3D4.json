      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21vdGQwdE5ZbEJOT1VRNVVHY3pNMGhZVW5KdUxXYxAB!2m1!1s0x3442a98c35d6169f:0x3edcc357f17daed8"
