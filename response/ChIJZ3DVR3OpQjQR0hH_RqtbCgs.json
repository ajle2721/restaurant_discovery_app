      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2kwME0weHFhMUl5ZFVSVU1GWlFXRk16UjJKYVRWRRAB!2m1!1s0x3442a97347d57067:0xb0a5bab46ff11d2"
