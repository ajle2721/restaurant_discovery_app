      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xGWlNWUlFlV0ZRVVU5RVVYQjVkM2RLYUhwck1tYxAB!2m1!1s0x3442abcdbb4e5a37:0x448c92318378d96b"
