      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNHd2VIaVRnEAE!2m1!1s0x3442ae8c49f0b90b:0x5ac73fc004f7c876"
