      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s1Q1VHSjRiV2REWVc5SlZYbENabDlQU1U1Tk9VRRAB!2m1!1s0x3442a9ea08ba76d9:0x775f72fb82f18508"
