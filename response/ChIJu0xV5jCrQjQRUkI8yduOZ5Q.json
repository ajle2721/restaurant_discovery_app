      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pndFZqa3dhVEJsT1RkdVJGOXphbkJLTWtJelFuYxAB!2m1!1s0x3442ab30e6554cbb:0x94678edbc93c4252"
