      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21KT1pGVkxYMmR0Y2psVlUxTmtRME5KVVRodVRYYxAB!2m1!1s0x3442ab86bea570a3:0x1f32b12f0f776ddd"
