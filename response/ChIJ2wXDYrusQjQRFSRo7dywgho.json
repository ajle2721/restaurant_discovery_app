      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT210eVVuUjFhamgyWlRGTlUyZDJhV0Z1UzI4NE0zYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT210eVVuUjFhamgyWlRGTlUyZDJhV0Z1UzI4NE0zYxAB!2m1!1s0x3442acbb62c305db:0x1a82b0dced682415"
