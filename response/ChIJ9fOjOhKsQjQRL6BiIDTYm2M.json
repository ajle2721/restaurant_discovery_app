      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psWE1XSXdUMjkzWlVzd09ETXdObTFzYVdWTVZFRRAB!2m1!1s0x3442ac123aa3f3f5:0x639bd8342062a02f"
