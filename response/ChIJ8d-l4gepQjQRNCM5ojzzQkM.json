      "publishTime": "2025-06-26T14:02:13.838552099Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xKUmVqTnJUSFJvWWkwdGNrMW5WREI2YlZSdFQyYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xKUmVqTnJUSFJvWWkwdGNrMW5WREI2YlZSdFQyYxAB!2m1!1s0x3442a907e2a5dff1:0x4342f33ca2392334"
