      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tSTFVIQlpUemR6V25sR1RFczFPV2hFZG5GSFQzYxAB!2m1!1s0x3442ab69d43c1b5d:0xea34fbb02a6008cc"
