      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25WSFQzUlFiR1pyVEZKRVlVcENNRVI0WVdsSVZWRRAB!2m1!1s0x3442abb2240d7bb3:0x1fb38d292f1c410d"
