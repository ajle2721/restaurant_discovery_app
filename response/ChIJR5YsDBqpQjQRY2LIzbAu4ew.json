      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT205ek5sZE1WRTVEZDNSWVNURndSM0pqVURSamNtYxAB!2m1!1s0x3442a91a0c2c9647:0xece12eb0cdc86263"
