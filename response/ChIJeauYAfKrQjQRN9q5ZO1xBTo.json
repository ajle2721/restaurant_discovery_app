      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2w5R1RrbFNTbU5XWTNoaVMzcHFNMjk0WmpoeE1XYxAB!2m1!1s0x3442abf20198ab79:0x3a0571ed64b9da37"
