      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xkM2IydE9WbEpJWTJaVU9UVnRRbWxGU1c5M04xRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xkM2IydE9WbEpJWTJaVU9UVnRRbWxGU1c5M04xRRAB!2m1!1s0x3442ab8d198cd5bd:0x3cd95ae836d25d8c"
