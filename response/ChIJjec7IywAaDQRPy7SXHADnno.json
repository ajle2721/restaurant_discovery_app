      "text": {
        "text": "9/29休假日 中午一點半用餐體驗非常好\n已列入口袋名單！",
        "languageCode": "zh-Hant"
      },
      "originalText": {
        "text": "9/29休假日 中午一點半用餐體驗非常好\n已列入口袋名單！",
        "languageCode": "zh-Hant"
      },
      "authorAttribution": {
        "displayName": "Eric Lin",
        "uri": "https://www.google.com/maps/contrib/109164279641841212080/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjXv_SqwxAU3D79fJ6Hqj0UgNoy8FWUMkVAXSW9C8A7xN7TJbBTDVw=s128-c0x00000000-cc-rp-mo-ba5"
      },
      "publishTime": "2025-10-01T02:47:38.886089363Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2kxV1RGUlRVMjV4ZUdGRU0xYzVVR1pmVkhkVU5sRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2kxV1RGUlRVMjV4ZUdGRU0xYzVVR1pmVkhkVU5sRRAB!2m1!1s0x3468002c233be78d:0x7a9e03705cd22e3f"
