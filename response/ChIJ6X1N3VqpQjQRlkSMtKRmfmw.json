      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tFNGJVaE5jV1ZZUWtGWlJGZHljWE0yVmxCQlUzYxAB!2m1!1s0x3442a95add4d7de9:0x6c7e66a4b48c4496"
