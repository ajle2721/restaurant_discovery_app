      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pBMFZIWldUVlpRTW1oNFdFTjNWV3hpU0ZKcVFYYxAB!2m1!1s0x3442ae5409120f15:0x98c5f7ef9aca31af"
