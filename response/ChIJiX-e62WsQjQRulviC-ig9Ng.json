      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnTUNvNGMtcXJ3RRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTUNvNGMtcXJ3RRAB!2m1!1s0x3442ac65eb9e7f89:0xd8f4a0e80be25bba"
