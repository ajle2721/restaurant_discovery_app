      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGWFZUaDFXRGxoWTFaSVFWTlRWbGRRYjFSR2NVRRAB!2m1!1s0x3442abbff13f8f85:0x2b3de34df217e00b"
