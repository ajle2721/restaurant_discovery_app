      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21sd2FXbDRkRFZxYTJoc05YTmhjMEUzZDJaS2EyYxAB!2m1!1s0x3442a906ba8af739:0xe5bcae0bb4d9e094"
