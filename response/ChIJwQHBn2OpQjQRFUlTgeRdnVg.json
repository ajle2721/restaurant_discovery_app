      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xOV1UxQTVTekpKUm5kS1lYQnZZbDlpWXpSamFHYxAB!2m1!1s0x3442a9639fc101c1:0x589d5de481534915"
