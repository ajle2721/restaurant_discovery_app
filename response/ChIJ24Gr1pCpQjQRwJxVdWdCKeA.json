      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5V2NVNXFOMnBTV1RWZmNXbG1TMGRZWWxRMWVrRRAB!2m1!1s0x3442a990d6ab81db:0xe029426775559cc0"
