      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT20xTGFtVm1UWGxJU0VwYVVsUXRXVVo2UVVoNU4xRRAB!2m1!1s0x3442a913cfff2b65:0x5d42c1e216f22745"
