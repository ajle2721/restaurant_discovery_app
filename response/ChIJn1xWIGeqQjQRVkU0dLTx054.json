      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNabzVQRVlnEAE!2m1!1s0x3442aa6720565c9f:0x9ed3f1b474344556"
