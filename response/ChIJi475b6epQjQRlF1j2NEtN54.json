      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psYU4zRmpMVmx0UXpScFdYSjRZM0ozT0d0dloxRRAB!2m1!1s0x3442a9a76ff98e8b:0x9e372dd1d8635d94"
