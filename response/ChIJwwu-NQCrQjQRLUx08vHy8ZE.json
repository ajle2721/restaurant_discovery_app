      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pSalluVnJiMWxrY25wZlZXNXZVM05WTmt4V00zYxAB!2m1!1s0x3442ab0035be0bc3:0x91f1f2f1f2744c2d"
