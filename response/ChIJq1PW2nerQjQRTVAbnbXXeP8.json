      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21Ob1JWbENTVVZsVEdsYVYxUmFPVGhJTUZkSmQxRRAB!2m1!1s0x3442ab77dad653ab:0xff78d7b59d1b504d"
