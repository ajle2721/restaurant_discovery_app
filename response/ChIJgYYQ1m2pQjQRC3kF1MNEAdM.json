      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CRVZHdFVWbEJPTFUwdGFuSkVjWFJVVUc0dFluYxAB!2m1!1s0x3442a96dd6108681:0xd30144c3d405790b"
