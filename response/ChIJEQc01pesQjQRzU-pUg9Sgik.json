      "publishTime": "2025-06-04T11:29:31.459348Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VOcWhnUG1fNjhpcy13RRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VOcWhnUG1fNjhpcy13RRAB!2m1!1s0x3442ac97d6340711:0x2982520f52a94fcd"
