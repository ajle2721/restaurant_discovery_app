      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tKcFJtSmtRbXB6ZFVwVWVWZHZXbUpPWldKelMzYxAB!2m1!1s0x3442abc1da741599:0x5751e77b78e46114"
