      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCV1QzVTBUMjVzTmtwNGVqbDVTSGd6YjBORU5FRRAB!2m1!1s0x3442ad8c58701f61:0x2f8398da54e80cf2"
