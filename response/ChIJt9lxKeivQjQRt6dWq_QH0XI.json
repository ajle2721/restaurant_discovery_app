      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21KSGJFUnJNa0ZpWVV0MFIzTlRYMWxKVG1kb01uYxAB!2m1!1s0x3442afe82971d9b7:0x72d107f4ab56a7b7"
