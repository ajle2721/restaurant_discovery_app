      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tOTU0yRlpUbWQ0TUdwek1XbHVaMWxVUjI5bFNrRRAB!2m1!1s0x3442abda6b64f943:0x36a2c9b4b5f31ea8"
