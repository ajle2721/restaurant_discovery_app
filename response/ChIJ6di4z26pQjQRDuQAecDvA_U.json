      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taUFpFOWpZMVl0UlhWMGRUVk9kblpZV1VabVpsRRAB!2m1!1s0x3442a96ecfb8d8e9:0xf503efc07900e40e"
