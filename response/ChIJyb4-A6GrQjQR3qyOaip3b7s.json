      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s1UUxXZEdUbTlvUjJwcmR6WkhlVVJOUlROaFowRRAB!2m1!1s0x3442aba1033ebec9:0xbb6f772a6a8eacde"
