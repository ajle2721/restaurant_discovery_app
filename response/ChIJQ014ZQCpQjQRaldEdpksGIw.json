      "publishTime": "2025-12-21T13:28:36.068906284Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2psQ2JuZzFUVjlUZW5GV1gxRTNaMEpSY2tGS2VIYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2psQ2JuZzFUVjlUZW5GV1gxRTNaMEpSY2tGS2VIYxAB!2m1!1s0x3442a90065784d43:0x8c182c997644576a"
