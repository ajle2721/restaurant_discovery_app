      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5RVFUYzVSMmRqTkc4NFpUWldjbTEzZERVMWVVRRAB!2m1!1s0x346801916500d697:0x1bbe57a30217cff5"
