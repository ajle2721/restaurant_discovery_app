      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21jMlpFNHpXbEYwYVRWT1ZHVkRVVVJXTFc1UmNsRRAB!2m1!1s0x3442a9a931e233c7:0x2b49f7ec734151ee"
