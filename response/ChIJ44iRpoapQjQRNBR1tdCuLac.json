      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tkUmMxbDZRV1J3V0ZsbmQyRkVPRk41WVZscGFsRRAB!2m1!1s0x3442a986a69188e3:0xa72daed0b5751434"
