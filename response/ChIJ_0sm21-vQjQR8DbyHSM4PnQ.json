      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xCbFZIWnNTMlpUVXpkMVYzVTRVbU0wT1RGT1drRRAB!2m1!1s0x3442af5fdb264bff:0x743e38231df236f0"
