      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pobU9EUmphRFpvYzJSU1FrVTFlbXBDYkROa1pYYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pobU9EUmphRFpvYzJSU1FrVTFlbXBDYkROa1pYYxAB!2m1!1s0x3442a9824e8cc11d:0x813c6ba07cc66771"
