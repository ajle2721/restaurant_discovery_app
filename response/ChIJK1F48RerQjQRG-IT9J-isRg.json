      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsUVZWVnBZemRQVEZobVNVbFFjbkpyTWtObkxXYxAB!2m1!1s0x3442ab17f178512b:0x18b1a29ff413e21b"
