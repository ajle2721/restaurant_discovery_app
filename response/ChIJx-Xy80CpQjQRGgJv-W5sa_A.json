      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pjM2R6TnBORGxtVFVselVUaFFSRlJHTm5Cc2NGRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pjM2R6TnBORGxtVFVselVUaFFSRlJHTm5Cc2NGRRAB!2m1!1s0x3442a940f3f2e5c7:0xf06b6c6ef96f021a"
