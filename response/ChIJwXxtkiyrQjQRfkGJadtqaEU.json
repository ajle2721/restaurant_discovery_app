      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taZmEwWlVjR1pzZFZsVVNHZGtXVkp0ZVc1dlFuYxAB!2m1!1s0x3442ab2c926d7cc1:0x45686adb6989417e"
