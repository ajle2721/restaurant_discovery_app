      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xGTFVDMUdSV3hzYkMxRlZGbDFSa1UyU201UlYxRRAB!2m1!1s0x3442abd763564773:0x919ebbd4097513f1"
