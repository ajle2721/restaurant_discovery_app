      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xSb09XMXNaRjlJT1dNM1RtSk5hVTVxWmtadlRHYxAB!2m1!1s0x3442ae515444fd49:0xa2748ea66da6fe48"
