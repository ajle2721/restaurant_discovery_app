      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUR5dnVIaVFREAE!2m1!1s0x3442a913c69cbbff:0xecc7e3e428d8b23e"
