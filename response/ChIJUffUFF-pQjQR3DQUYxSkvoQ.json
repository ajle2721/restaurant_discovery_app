      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25oME5IVkJOa2wzY1UxMmQwNUVVMjlRV1hOWVJYYxAB!2m1!1s0x3442a95f14d4f751:0x84bea414631434dc"
