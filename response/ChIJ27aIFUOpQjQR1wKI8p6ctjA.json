      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2sxU1lqRmxjVlZmUVVoTlZFdGtRMll5WlU0emRsRRAB!2m1!1s0x3442a9431588b6db:0x30b69c9ef28802d7"
