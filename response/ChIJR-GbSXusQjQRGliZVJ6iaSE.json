      "publishTime": "2025-02-13T04:42:51.753482Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnTUNnZ0pESlhREAE&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUNnZ0pESlhREAE!2m1!1s0x3442ac7b499be147:0x2169a29e5499581a"
