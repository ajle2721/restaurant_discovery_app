      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taTVRtdGFTMk5xYVUxS2JVOXBlV2h4UjJGQmRHYxAB!2m1!1s0x3442a9f52522408f:0x146fb5c5f3fc140e"
