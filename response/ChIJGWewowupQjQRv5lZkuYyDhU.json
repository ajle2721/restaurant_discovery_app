      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT214V1pFdHpTSEpQVTFSRmRGOTFjR05IYmxveE0yYxAB!2m1!1s0x3442a90ba3b06719:0x150e32e6925999bf"
