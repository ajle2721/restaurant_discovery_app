      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pSQ1dVVTJka1l3VEhGelVpMVFaMTl0UTFodmFXYxAB!2m1!1s0x3442ae4301928083:0x618fd8543bdc697c"
