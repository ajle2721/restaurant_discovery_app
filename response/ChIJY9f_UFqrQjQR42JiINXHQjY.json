      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT25Sek5FMVphM0J1VlZKQ04xWm1iemxaYW1jMlIyYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25Sek5FMVphM0J1VlZKQ04xWm1iemxaYW1jMlIyYxAB!2m1!1s0x3442ab5a50ffd763:0x3642c7d5206262e3"
