      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21Fd2VrSk1RMjVtWkVSVFZuTnJaSGd3UVdsWldrRRAB!2m1!1s0x3442a9dfc9540aeb:0x5c2cd91744c7585a"
