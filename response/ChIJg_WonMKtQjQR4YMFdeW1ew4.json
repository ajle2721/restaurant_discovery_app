      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21oVldVeDBZMmx6T1RWWU4zYzRTWGg0VHpkTFVXYxAB!2m1!1s0x3442adc29ca8f583:0xe7bb5e5750583e1"
