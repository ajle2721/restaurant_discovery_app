      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsbWRXNW5RVFZ2Tm5NeVoyMWlTa1ZTVUZWeWFtYxAB!2m1!1s0x3442a9f806a66e93:0xfa5e98846567af25"
