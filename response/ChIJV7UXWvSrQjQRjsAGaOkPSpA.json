      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taUlFWUlFiazB5YUVaUU5EZHZhbGxCWlRGUVgyYxAB!2m1!1s0x3442abf45a17b557:0x904a0fe96806c08e"
