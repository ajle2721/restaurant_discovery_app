      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xSc2FVaHlSM1JQZG1neVZuZDBTVzlUWlhkQmFXYxAB!2m1!1s0x3442a94ca1becc79:0x596774cff159b1a6"
